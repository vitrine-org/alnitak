[
  {
    "title": "Layout",
    "settings": {
      "showWeather": {
        "type": "boolean",
        "default": true,
        "label": "Show weather",
        "description": "Today's weather in three lines under the time"
      },
      "showDivider": {
        "type": "boolean",
        "default": true,
        "label": "Show dividers",
        "description": "A rule above the time and one below the weather, as in the original theme"
      }
    }
  },
  {
    "title": "Weather",
    "settings": {
      "city": {
        "type": "string",
        "default": "London",
        "label": "City",
        "description": "Any city name; the first match from Open-Meteo is used",
        "visibleWhen": {
          "key": "showWeather",
          "value": true
        }
      },
      "units": {
        "type": "string",
        "default": "celsius",
        "label": "Temperature unit",
        "options": [
          {
            "value": "celsius",
            "label": "Celsius (°C)"
          },
          {
            "value": "fahrenheit",
            "label": "Fahrenheit (°F)"
          }
        ],
        "visibleWhen": {
          "key": "showWeather",
          "value": true
        }
      }
    }
  },
  {
    "title": "Appearance",
    "settings": {
      "theme": {
        "type": "string",
        "default": "dark",
        "label": "Text color",
        "description": "Light text suits dark wallpapers, dark text light ones",
        "options": [
          {
            "value": "dark",
            "label": "Light (dark wallpaper)"
          },
          {
            "value": "light",
            "label": "Dark (light wallpaper)"
          },
          {
            "value": "auto",
            "label": "Follow Windows theme"
          }
        ]
      },
      "accent": {
        "type": "string",
        "default": "#448AFF",
        "label": "Accent color",
        "description": "Hex color for the highlighted letter and minutes, or system for the Windows accent",
        "pattern": "^(system|#[0-9a-fA-F]{6})$",
        "patternMessage": "Use system or a hex color such as #448AFF"
      },
      "background": {
        "type": "string",
        "default": "none",
        "label": "Background",
        "options": [
          {
            "value": "none",
            "label": "None (on the wallpaper)"
          },
          {
            "value": "acrylic",
            "label": "Acrylic card"
          }
        ]
      },
      "shadow": {
        "type": "boolean",
        "default": true,
        "label": "Text shadow",
        "description": "A soft shadow for legibility on bright or busy wallpapers",
        "visibleWhen": {
          "key": "background",
          "value": "none"
        }
      }
    }
  }
]
